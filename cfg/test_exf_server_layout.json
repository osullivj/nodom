          "day_date_font": "Arial",
          "day_date_font_size": 8
        }
      },
      { "rname": "SameLine" },
      { "rname": "Text", "cspec": { "text": "Start date" } },
      {
        "rname": "DatePicker",
        "cspec": {
          "cname": "end_date",
          "year_month_font": "CourierNew",
          "year_month_font_size": 12,
          "day_date_font": "Arial",
          "day_date_font_size": 8
        }
      },
      { "rname": "SameLine" },
      { "rname": "Text", "cspec": { "text": "End date" } },
      { "rname": "Separator" },
      {
        "rname": "Button",
        "widget_id": "i_am_the_scan_button",
        "cspec": { "text": "Scan" }
      },
      { "rname": "SameLine" },
      {
        "rname": "Button",
        "widget_id": "i_am_the_summary_button",
        "cspec": { "text": "Summary" }
      },
      {
        "rname": "Button",
        "widget_id": "i_am_the_chart_button",
        "cspec": { "text": "Chart" }
      },
      {
        "rname": "Footer",
        "cspec": {
          "db": true,
          "fps": true,
          "demo": true,
          "id_stack": true,
          "memory": true,
          "font_scale": true,
          "style": true
        }
      },
      { "rname": "EndChild" },
      { "rname": "SameLine" },
      {
        "rname": "Table",
        "cspec": {
          "title": "Depth grid",
          "query_id": "the_depth_query"
        }
      }
    ]
  },
  {
    "widget_id": "i_am_parquet_loading_modal",
    "rname": "LoadingModal",
    "cspec": {
      "title": "Loading parquet...",
      "title_font": "Arial",
      "body_font": "CourierNew",
      "cname": "scan_urls",
      "spinner_radius": 20,
      "spinner_thickness": 4
    }
  },
  {
    "widget_id": "i_am_depth_summary_modal",
    "rname": "DuckTableSummaryModal",
    "cspec": {
      "title": "Depth table",
      "query_id":"the_depth_summary",
      "menupop":"summary_rclick_menupop",
      "title_font": "Arial",
      "body_font": "CourierNew",
      "cname": "scan_urls",
      "spinner_radius": 20,
      "spinner_thickness": 4
    }
  },
  {
    "widget_id": "i_am_memory_editor",
    "rname": "MemoryEditor",
    "cspec": {
      "title": "Memory Editor",
      "query_id":"the_depth_query"
    }
  },
  {
    "widget_id": "i_am_chart_window",
    "rname": "Window",
    "cspec": {
      "title": "Chart",
      "title_font":"Arial",
      "window_flags":0
    },
    "children":[
      {
        "rname":"ShadedPlot",
        "widget_id":"i_am_plot",
        "cspec":{
          "query_id":"the_depth_query",
          "show_fills":true,
          "show_lines":true,
          "title":"AskPrice1 vs SeqNo",
          "xname":"xaxis",
